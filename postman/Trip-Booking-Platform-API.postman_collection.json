    {
      "name": "Payment service (read-only, :8081)",
      "description": "Charging is driven by the saga (Kafka), not REST. These GETs verify a recorded payment.\n\nThese hit :8081 DIRECTLY, bypassing the gateway \u2014 and nothing stops them: payment-service has no authentication, so reaching the port is all it takes.",
      "item": [
        {
          "name": "Look up payment by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('same payment returned', () => pm.expect(pm.response.json().paymentId).to.eql(pm.collectionVariables.get('paymentId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{paymentUrl}}/api/payments/{{paymentId}}",
              "host": [
                "{{paymentUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "{{paymentId}}"
              ]
            },
            "description": "Proves the payment is durable, not just a log line. Run a booking first to capture {{paymentId}}. No authentication \u2014 this bypasses the gateway and payment-service does not check callers."
          }
        },
        {
          "name": "List payments by booking reference",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{paymentUrl}}/api/payments?tripReference=manual-test-1",
              "host": [
                "{{paymentUrl}}"
              ],
              "path": [
                "api",
                "payments"
              ],
              "query": [
                {
                  "key": "tripReference",
                  "value": "manual-test-1"
                }
              ]
            },
            "description": "All attempts for one booking reference, newest first - reconciliation/support view.\n\nNOTE: anyone can read any tripReference. payment-service stores a tripReference, not a userId, so it cannot tell whose payment a row is without asking booking-service."
          }
        },
        {
          "name": "Unknown payment id -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{paymentUrl}}/api/payments/does-not-exist",
              "host": [
                "{{paymentUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "does-not-exist"
              ]
            },
            "description": "404 for an id that does not exist. Nothing is authenticated, so this is the only failure mode."
          }
        }
      ]
    },
    {
      "name": "Cleanup",
      "description": "Run last: releases the seat and room the main flow reserved, so the collection can be re-run.",
      "item": [
        {
          "name": "Cancel trip (release seat + room)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status is CANCELLED', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips",
                "{{tripId}}",
                "cancel"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Direct to booking-service (bypass gateway, for comparison)",
      "description": "Everything else in this collection goes through the gateway ({{baseUrl}} = :8090), which is what keeps Zipkin traces rooted at a gateway span. This folder is the deliberate exception: it hits booking-service on {{directBookingUrl}} (:8080) directly, so you can compare the response to the same request through the gateway and confirm they're identical.",
      "item": [
        {
          "name": "List flights (direct, bypasses gateway)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{directBookingUrl}}/api/flights",
              "host": [
                "{{directBookingUrl}}"
              ],
              "path": [
                "api",
                "flights"
              ]
            },
            "description": "Compare this response to 'Flights > List flights', which now goes through the gateway. Same data, same shape -- the gateway adds routing, not behavior."
          }
        }
      ]
    }
  ]
