    {
      "name": "Trips",
      "item": [
        {
          "name": "Book trip (async saga -> 202 PENDING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('tripId', json.id);",
                  "pm.test('starts PENDING', () => pm.expect(json.status).to.eql('PENDING'));",
                  "console.log('trip ' + json.id + ' PENDING \u2014 poll GET /api/trips/'+json.id+' until CONFIRMED');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seatId\": {{seatId}},\n  \"roomId\": {{roomId}},\n  \"userId\": {{userId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips"
              ]
            },
            "description": "Publishes a PaymentRequested event and returns 202 PENDING immediately. The payment service charges asynchronously; poll 'Get trip by id' until status becomes CONFIRMED (or CANCELLED if payment declined).\n\nThe owner is the {{userId}} in the body \u2014 client-supplied and unverified, since the platform has no authentication."
          }
        },
        {
          "name": "List trips",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/trips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips"
              ]
            }
          }
        },
        {
          "name": "Get trip by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "console.log('trip status: ' + pm.response.json().status + ' (re-send until CONFIRMED)');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/trips/{{tripId}}",
              "host": [
